{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/get_messages_oauth2",
        "destination": "https://tools.dongvanfb.net/api/get_messages_oauth2"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
